# =============================================================================
# Polymarket Arbitrage Bot - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values

# =============================================================================
# General
# =============================================================================
NODE_ENV=development

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# =============================================================================
# Polymarket Configuration
# =============================================================================
# WebSocket URL for market data
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# CLOB API URL
POLYMARKET_API_URL=https://clob.polymarket.com

# Market configuration (format: MARKET_ID:YES_TOKEN:NO_TOKEN, comma-separated)
# Example: 0x1234...abcd:0xyes...token:0xno...token
MARKET_CONFIG=

# =============================================================================
# Strategy Engine Configuration
# =============================================================================
# Trade size in USDC for VWAP calculation
TRADE_SIZE_USDC=500

# Minimum net spread to trigger trade (e.g., 0.02 = 2%)
MIN_NET_SPREAD=0.02

# Maximum acceptable price impact (e.g., 0.02 = 2%)
MAX_PRICE_IMPACT=0.02

# Data staleness threshold in milliseconds (default: 5000 = 5s)
STALE_THRESHOLD_MS=5000

# =============================================================================
# Executor Configuration
# =============================================================================
# Trading mode: PAPER (simulation) or LIVE (real transactions)
EXECUTOR_MODE=PAPER

# Polygon RPC URL (use a reliable provider for production)
POLYGON_RPC_URL=https://polygon-rpc.com

# Private key for the trading wallet (REQUIRED for LIVE mode)
# WARNING: Never commit this value! Use environment variables or secrets manager.
# PRIVATE_KEY=your_private_key_here

# =============================================================================
# Gas Configuration (Polygon)
# =============================================================================
# Maximum fee per gas in gwei (safety cap)
MAX_FEE_PER_GAS_GWEI=500

# Priority fee multiplier (1.5 = 50% above median for next-block inclusion)
PRIORITY_FEE_MULTIPLIER=1.5

# Gas limit buffer (1.2 = 20% extra on estimates)
GAS_LIMIT_BUFFER=1.2

# =============================================================================
# Safety / Circuit Breaker
# =============================================================================
# Minimum USDC balance to continue trading
MIN_BALANCE_USDC=100

# Maximum consecutive transaction reverts before halting
MAX_CONSECUTIVE_REVERTS=3

# Cooldown period after circuit breaker trips (in milliseconds)
CIRCUIT_BREAKER_COOLDOWN_MS=300000

# Maximum concurrent transactions
MAX_CONCURRENT_TX=5

# =============================================================================
# Contract Addresses (Polygon Mainnet)
# =============================================================================
# USDC token address on Polygon
USDC_ADDRESS=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174

# Polymarket CTF Exchange contract
CTF_EXCHANGE_ADDRESS=0x4bFb41d5B3570DeFd03C39a9A4D8dE6Bd8B8982E

# =============================================================================
# Monitoring
# =============================================================================
# Metrics server port for each service
METRICS_PORT_INGESTOR=9100
METRICS_PORT_STRATEGY=9101
METRICS_PORT_EXECUTOR=9102
